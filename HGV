
#include <stdio.h>

int main() {
    int grades = 0;
    printf("how many grades do you got");
    scanf("%d", &grades);
    if (grades >= 90){
        printf("your got grade A");
    }
    else if (grades >= 70){
        printf("your got grade b");        
    }
    else if (grades >= 60){
        printf("your got grade c");
    } 
    else if (grades <= 60){
        printf("your got grade d");
    }    
    else if (grades <= 50){
        printf("your got grade f");
    }
    else{
        printf("you need to improve");
    }
        
    return 0;
}









